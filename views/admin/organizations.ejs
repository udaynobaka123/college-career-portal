<%- include('../partials/header') %><div class="page-heading"><h1>Organizations</h1></div><form method="post" class="detail-panel mb-4"><h5>Add organization</h5><div class="row"><% [['Organization name','name'],['Email','email'],['Phone','phone'],['Website','website'],['Address','address']].forEach(([l,n])=>{ %><div class="col-md-4 mb-3"><label class="form-label"><%= l %></label><input name="<%= n %>" class="form-control" <%= n==='name'?'required':'' %>></div><% }) %></div><button class="btn btn-primary">Add organization</button></form><div class="detail-panel"><ul class="list-group list-group-flush"><% organizations.forEach(o=>{ %><li class="list-group-item"><strong><%= o.name %></strong><span class="text-muted ms-2"><%= o.email||'' %></span></li><% }) %></ul></div><%- include('../partials/footer') %>