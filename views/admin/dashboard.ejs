<%- include('../partials/header') %><div class="dash-head"><div><span class="eyebrow">ADMINISTRATION</span><h1>Portal overview</h1><p class="text-muted">Manage career opportunities and student engagement.</p></div></div><div class="row g-3"><% Object.entries(stats).forEach(([k,v])=>{ %><div class="col-6 col-lg-3"><div class="statbox"><h3><%= v %></h3><span><%= k.replace(/([A-Z])/g,' $1') %></span></div></div><% }) %></div><div class="row g-3 mt-3"><% [['Opportunities','/admin/opportunities'],['Students','/admin/students'],['Organizations','/admin/organizations'],['Applications','/admin/applications']].forEach(([t,u])=>{ %><div class="col-md-3"><a class="quick-link" href="<%= u %>"><h5><%= t %></h5><p>Manage records <i class="fa fa-arrow-right float-end"></i></p></a></div><% }) %></div><%- include('../partials/footer') %>