<%- include('../partials/header') %><div class="page-heading"><h1>My profile</h1><p>Keep your academic and contact information up to date.</p></div><form method="post" class="detail-panel"><div class="row"><% [['Full name','name',profile.name],['Email','email',profile.email],['Student ID','student_id',profile.student_id],['Department','department',profile.department],['Program','program',profile.program],['Year of study','year_of_study',profile.year_of_study],['Graduation year','graduation_year',profile.graduation_year]].forEach(([l,n,v])=>{ %><div class="col-md-6 mb-3"><label class="form-label"><%= l %></label><input class="form-control" name="<%= n %>" value="<%= v||'' %>" <%= n==='student_id'?'readonly':'' %>></div><% }) %></div><button class="btn btn-primary">Save profile</button></form><%- include('../partials/footer') %>