<%- include('../partials/header') %><div class="page-heading"><h1>Registered students</h1></div><div class="detail-panel table-responsive"><table class="table"><thead><tr><th>Name</th><th>Student ID</th><th>Email</th><th>Department</th><th>Year</th><th>Account</th><th></th></tr></thead><tbody><% students.forEach(s=>{ %><tr><td><%= s.name %></td><td><%= s.student_id %></td><td><%= s.email %></td><td><%= s.department %></td><td><%= s.year_of_study||'-' %></td><td><%= s.active?'Active':'Inactive' %></td><td><form method="post" action="/admin/students/<%= s.id %>/toggle"><button class="btn btn-sm btn-outline-secondary"><%= s.active?'Deactivate':'Activate' %></button></form></td></tr><% }) %></tbody></table></div><%- include('../partials/footer') %>