<%- include('../partials/header') %><div class="dash-head"><div><span class="eyebrow">STUDENT SPACE</span><h1>Welcome, <%= user.name %></h1><p class="text-muted">Your career journey at a glance.</p></div><a href="/opportunities" class="btn btn-primary">Find opportunities</a></div><div class="row g-3"><% [['Applications',stats.total,'fa-paper-plane'],['Submitted',stats.submitted,'fa-hourglass-half'],['Shortlisted',stats.shortlisted,'fa-star'],['Saved',saved,'fa-bookmark']].forEach(([label,val,ico])=>{ %><div class="col-6 col-lg-3"><div class="statbox"><i class="fa <%= ico %>"></i><h3><%= val %></h3><span><%= label %></span></div></div><% }) %></div><div class="row g-3 mt-3"><% [['My applications','/student/applications','Track progress'],['Saved opportunities','/student/saved','Your shortlist'],['My profile','/student/profile','Keep your details current']].forEach(([t,url,d])=>{ %><div class="col-md-4"><a class="quick-link" href="<%= url %>"><h5><%= t %></h5><p><%= d %> <i class="fa fa-arrow-right float-end"></i></p></a></div><% }) %></div><%- include('../partials/footer') %>