
<%- include('../partials/header', { title: 'Manage Opportunities' }) %>

<div class="container mt-4 mb-5">

    <!-- Page Heading -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="fw-bold">Manage Opportunities</h1>
            <p class="text-muted mb-0">
                View, manage and update career opportunities.
            </p>
        </div>

        <a href="/admin/opportunities/new" class="btn btn-primary">
            + Create Opportunity
        </a>
    </div>

    <!-- Opportunities Table -->
    <div class="detail-panel table-responsive">

        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>Title</th>
                    <th>Company</th>
                    <th>Type</th>
                    <th>Location</th>
                    <th>Deadline</th>
                    <th>Status</th>
                    <th>Update Status</th>
                </tr>
            </thead>

            <tbody>

                <% if (opportunities && opportunities.length > 0) { %>

                    <% opportunities.forEach(o => { %>

                        <tr>

                            <!-- Opportunity Title -->
                            <td>
                                <strong><%= o.title %></strong>
                            </td>

                            <!-- Company Name -->
                            <td>
                                <%= o.company_name || 'Not specified' %>
                            </td>

                            <!-- Opportunity Type -->
                            <td>
                                <%= o.opportunity_type || 'Not specified' %>
                            </td>

                            <!-- Location -->
                            <td>
                                <%= o.location || 'Not specified' %>
                            </td>

                            <!-- Application Deadline -->
                            <td>
                                <% if (o.application_deadline) { %>
                                    <%= new Date(o.application_deadline).toLocaleDateString('en-GB') %>
                                <% } else { %>
                                    <span class="text-muted">No deadline</span>
                                <% } %>
                            </td>

                            <!-- Current Status -->
                            <td>
                                <% if (o.status === 'approved') { %>
                                    <span class="badge bg-success">Approved</span>
                                <% } else if (o.status === 'pending') { %>
                                    <span class="badge bg-warning text-dark">Pending</span>
                                <% } else if (o.status === 'rejected') { %>
                                    <span class="badge bg-danger">Rejected</span>
                                <% } else if (o.status === 'closed') { %>
                                    <span class="badge bg-secondary">Closed</span>
                                <% } else { %>
                                    <span class="badge bg-secondary">
                                        <%= o.status %>
                                    </span>
                                <% } %>
                            </td>

                            <!-- Update Status -->
                            <td>
                                <form
                                    method="POST"
                                    action="/admin/opportunities/<%= o.id %>/status">

                                    <select
                                        name="status"
                                        class="form-select form-select-sm"
                                        onchange="this.form.submit()">

                                        <option value="pending"
                                            <%= o.status === 'pending' ? 'selected' : '' %>>
                                            Pending
                                        </option>

                                        <option value="approved"
                                            <%= o.status === 'approved' ? 'selected' : '' %>>
                                            Approved
                                        </option>

                                        <option value="rejected"
                                            <%= o.status === 'rejected' ? 'selected' : '' %>>
                                            Rejected
                                        </option>

                                        <option value="closed"
                                            <%= o.status === 'closed' ? 'selected' : '' %>>
                                            Closed
                                        </option>

                                    </select>

                                </form>
                            </td>

                        </tr>

                    <% }) %>

                <% } else { %>

                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            No opportunities have been created yet.
                        </td>
                    </tr>

                <% } %>

            </tbody>

        </table>

    </div>

</div>

<%- include('../partials/footer') %>
