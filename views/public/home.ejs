<%- include('../partials/header') %><section class="hero rounded-4 p-4 p-lg-5 mb-5"><div class="row align-items-center"><div class="col-lg-7"><span class="eyebrow">YOUR FUTURE STARTS HERE</span><h1 class="display-5 fw-bold mt-3">Discover your next <span>career opportunity.</span></h1><p class="lead mt-3">Explore internships, graduate roles, and jobs curated for our college community.</p><form action="/opportunities" class="searchbar mt-4"><input name="search" class="form-control" placeholder="Role, skill, or organization"><button class="btn btn-primary px-4"><i class="fa-solid fa-search me-2"></i>Search</button></form></div><div class="col-lg-5 d-none d-lg-block text-center"><div class="hero-art"><i class="fa-solid fa-briefcase"></i><i class="fa-solid fa-graduation-cap"></i><i class="fa-solid fa-rocket"></i></div></div></div></section><div class="row g-3 mb-5"><div class="col-md-6"><div class="statbox"><h3><%= stats.opportunities %></h3><span>Published opportunities</span></div></div><div class="col-md-6"><div class="statbox"><h3><%= stats.students %></h3><span>Student community</span></div></div></div><div class="d-flex justify-content-between align-items-center mb-3"><div><span class="eyebrow">HANDPICKED FOR YOU</span><h2 class="section-title">Featured opportunities</h2></div><a href="/opportunities" class="text-decoration-none">View all <i class="fa fa-arrow-right"></i></a></div><div class="row g-4"><% opportunities.forEach(o=>{ %><div class="col-md-6 col-lg-4"><%- include('../partials/opportunity-card',{o}) %></div><% }) %></div><% if(!opportunities.length){ %><div class="empty-state">No published opportunities yet. Check back soon.</div><% } %><div class="career-band mt-5 rounded-4 p-4 p-lg-5"><h2>Make your next move with confidence.</h2><p>Find opportunities, prepare your application, and keep track of every step.</p><a class="btn btn-light text-primary fw-bold" href="/opportunities">Explore opportunities</a></div><%- include('../partials/footer') %>