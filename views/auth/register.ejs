<%- include('../partials/header') %><div class="auth-wrap"><form method="post" action="/auth/register" class="auth-card"><span class="eyebrow">JOIN CAMPUSCAREER</span><h2>Create student account</h2><div class="row"><% [['Full name','name'],['Student ID','student_id'],['Email address','email'],['Password','password'],['Department','department'],['Program / course','program'],['Year of study','year_of_study'],['Graduation year','graduation_year']].forEach(([label,n])=>{ %><div class="col-md-6 mb-3"><label class="form-label"><%= label %></label><input class="form-control" name="<%= n %>" <%= ['email','password'].includes(n)?'type='+n:n==='year_of_study'||n==='graduation_year'?'type=number':'type=text' %> required></div><% }) %></div><button class="btn btn-primary w-100">Create account</button><p class="mt-3 text-center">Already registered? <a href="/auth/login">Sign in</a></p></form></div><%- include('../partials/footer') %>