
<%
    const deadline = o.application_deadline
        ? String(o.application_deadline).slice(0, 10)
        : null;

    const today = new Date();
    const todayString =
        today.getFullYear() + '-' +
        String(today.getMonth() + 1).padStart(2, '0') + '-' +
        String(today.getDate()).padStart(2, '0');

    const isOpen = !deadline || deadline >= todayString;

    const formattedDeadline = deadline
        ? new Date(deadline + 'T00:00:00').toLocaleDateString('en-GB')
        : 'No deadline';

    const formattedType = (o.opportunity_type || 'Opportunity')
        .replace(/-/g, ' ')
        .replace(/\b\w/g, char => char.toUpperCase());
%>

<article class="op-card h-100">

    <!-- Opportunity Type and Save Button -->
    <div class="d-flex justify-content-between align-items-center">

        <span class="type-pill">
            <%= formattedType %>
        </span>

        <% if (user && user.role === 'student') { %>

            <form method="POST"
                  action="/student/saved/<%= o.id %>">

                <button
                    type="submit"
                    class="btn btn-sm btn-outline-primary"
                    title="Save this opportunity">

                    <i class="fa-regular fa-bookmark"></i>
                    Save

                </button>

            </form>

        <% } %>

    </div>

    <!-- Opportunity Title -->
    <h5 class="mt-3">
        <a href="/opportunities/<%= o.id %>">
            <%= o.title %>
        </a>
    </h5>

    <!-- Company Name -->
    <div class="text-muted mb-3">
        <i class="fa-regular fa-building me-2"></i>
        <%= o.company_name || 'Company not specified' %>
    </div>

    <!-- Location -->
    <div class="meta-line">
        <i class="fa-solid fa-location-dot"></i>
        <%= o.location || 'Location flexible' %>
    </div>

    <!-- Application Status -->
    <div class="meta-line">
        <i class="fa-solid fa-calendar-check"></i>
        <%= isOpen ? 'Open for applications' : 'Application closed' %>
    </div>

    <!-- Deadline and Details -->
    <div class="card-bottom mt-4">

        <span class="small text-muted">
            Deadline: <%= formattedDeadline %>
        </span>

        <a href="/opportunities/<%= o.id %>"
           class="btn btn-sm <%= isOpen ? 'btn-outline-primary' : 'btn-outline-secondary' %>">

            View Details

        </a>

    </div>

</article>
