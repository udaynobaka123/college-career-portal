<%- include('../partials/header') %>

<div class="auth-wrap">
  <form method="POST" action="/auth/employer-register" class="auth-card">
    <span class="eyebrow">JOIN CAMPUSCAREER</span>

    <h2>Create employer account</h2>

    <p class="text-muted mb-4">
      Register your company to publish opportunities and connect with students.
    </p>

    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">Your full name</label>
        <input type="text" name="full_name" class="form-control" required />
      </div>

      <div class="col-md-6 mb-3">
        <label class="form-label">Company name</label>
        <input type="text" name="company_name" class="form-control" required />
      </div>

      <div class="col-md-6 mb-3">
        <label class="form-label">Email address</label>
        <input type="email" name="email" class="form-control" required />
      </div>

      <div class="col-md-6 mb-3">
        <label class="form-label">Phone number</label>
        <input type="text" name="phone" class="form-control" />
      </div>

      <div class="col-12 mb-3">
        <label class="form-label">Company website</label>
        <input
          type="url"
          name="company_website"
          class="form-control"
          placeholder="https://example.com"
        />
      </div>

      <div class="col-12 mb-3">
        <label class="form-label">Password</label>
        <input
          type="password"
          name="password"
          class="form-control"
          minlength="8"
          required
        />
        <small class="text-muted">
          Password must contain at least 8 characters.
        </small>
      </div>
    </div>

    <button type="submit" class="btn btn-primary w-100">
      Create employer account
    </button>

    <p class="mt-3 text-center">
      Already registered?
      <a href="/auth/login">Sign in</a>
    </p>

    <p class="text-center">
      Are you a student?
      <a href="/auth/register">Student registration</a>
    </p>
  </form>
</div>

<%- include('../partials/footer') %>
