<%- include('../partials/header') %><div class="dash-head"><div><span class="eyebrow">EMPLOYER SPACE</span><h1>Employer dashboard</h1><p class="text-muted">Submit vacancies for college approval.</p></div></div><% if(organization){ %><div class="detail-panel mb-4"><h4><%= organization.name %></h4><p><%= organization.email||'' %></p></div><% } %><form method="post" action="/employer/opportunities" class="detail-panel mb-4"><h4>Submit a vacancy</h4><div class="row"><% [['Title','title'],['Type','type'],['Location','location'],['Work arrangement','work_arrangement'],['Salary','salary'],['Deadline','deadline'],['Description','description']].forEach(([l,n])=>{ %><div class="col-md-6 mb-3"><label class="form-label"><%= l %></label><% if(n==='type'){ %><select name="type" class="form-select"><% ['Internship','Full-time','Part-time','Graduate Trainee','Contract'].forEach(x=>{ %><option><%= x %></option><% }) %></select><% }else if(n==='work_arrangement'){ %><select name="work_arrangement" class="form-select"><% ['Remote','On-site','Hybrid'].forEach(x=>{ %><option><%= x %></option><% }) %></select><% }else if(n==='description'){ %><textarea name="description" class="form-control" required></textarea><% }else{ %><input name="<%= n %>" class="form-control" <%= n==='deadline'?'type=date':'' %> required><% } %></div><% }) %></div><button class="btn btn-primary">Submit for approval</button></form><div class="detail-panel"><h4>Your opportunities</h4><% opportunities.forEach(o=>{ %><p><strong><%= o.title %></strong> · <span class="status-pill"><%= o.status %></span></p><% }) %></div><%- include('../partials/footer') %>