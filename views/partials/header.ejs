
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title><%= locals.title || 'Career Portal' %> | College Careers</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet">

    <link href="/css/style.css" rel="stylesheet">
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark topnav">
    <div class="container">

        <a class="navbar-brand fw-bold" href="/">
            <i class="fa-solid fa-compass me-2"></i>
            Campus<span class="brand-accent">Career</span>
        </a>

        <button class="navbar-toggler"
                data-bs-toggle="collapse"
                data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="nav">

            <ul class="navbar-nav ms-auto align-items-lg-center">

                <li class="nav-item">
                    <a class="nav-link" href="/opportunities">Opportunities</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/about">About</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/contact">Contact</a>
                </li>

                <% if (locals.user) { %>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="/<%= locals.user.role === 'admin' ? 'admin' : locals.user.role === 'employer' ? 'employer' : 'student' %>">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <form method="post" action="/auth/logout">
                            <button class="btn btn-sm btn-outline-light ms-lg-2">
                                Sign out
                            </button>
                        </form>
                    </li>

                <% } else { %>

                    <li class="nav-item">
                        <a class="nav-link" href="/auth/login">
                            Sign in
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="btn btn-sm btn-light text-primary fw-semibold ms-lg-2"
                           href="/auth/register">
                            Student sign up
                        </a>
                    </li>

                <% } %>

            </ul>
        </div>
    </div>
</nav>

<main class="container py-4">

    <% if (locals.success && locals.success.length) { %>

        <% locals.success.forEach(m => { %>

            <div class="alert alert-success alert-dismissible fade show">
                <%= m %>
                <button class="btn-close" data-bs-dismiss="alert"></button>
            </div>

        <% }) %>

    <% } %>

    <% if (locals.error && locals.error.length) { %>

        <% locals.error.forEach(m => { %>

            <div class="alert alert-danger alert-dismissible fade show">
                <%= m %>
                <button class="btn-close" data-bs-dismiss="alert"></button>
            </div>

        <% }) %>

    <% } %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>